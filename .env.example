# doreg development environment. Copy to .env; the values match compose.yaml.
# Every value here is public (it is in this repository). Never use them in
# production: see the notes at the bottom.

# --- Single sign-on (minicloak from minisuite) -------------------------------
# Enables the SSO login button. Issuer, client id, secret and redirect URI
# must all be set together.
OIDC_ISSUER=http://localhost:9500/realms/dev
OIDC_CLIENT_ID=doreg
OIDC_CLIENT_SECRET=doreg-dev-secret
# Must be registered at the provider: <public url>/api/auth/oidc/callback.
# In dev the browser uses the Vite server (just dev), which proxies /api to :8080.
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# Label of the login button.
OIDC_PROVIDER_NAME=minicloak
# Members of this role (or group) become system admins. alice has it.
OIDC_ADMIN_ROLE=registry-admin
# Verified emails that become admins (comma-separated). With neither this nor
# OIDC_ADMIN_ROLE set, the first SSO login becomes admin while none exists.
# OIDC_ADMIN_EMAILS=you@example.com
# Optional, defaults shown in the README:
# OIDC_SCOPES=openid,profile,email
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_GROUPS_CLAIM=

# --- Object storage (minibucket from minisuite) -------------------------------
# Blobs go to S3 when S3_BUCKET is set; the bucket is created on start.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=doreg
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Path-style addressing, needed for minibucket and MinIO. AWS S3 uses false.
S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket.
# S3_PREFIX=

# --- Metadata database ----------------------------------------------------------
# SQLite in ./data by default. To use the PostgreSQL from compose.yaml instead:
# DATABASE_URL=postgres://doreg:doreg@localhost:5432/doreg?sslmode=disable

# --- Initial admin ------------------------------------------------------------
# Created on first start when no users exist. Log in with these after `up`
# if OIDC is not used.
# Local fallback admin, created on first start when no users exist. Optional with SSO.
DOREG_ADMIN_USER=admin
DOREG_ADMIN_PASSWORD=change-me

# --- Webhooks -------------------------------------------------------------------
# Allow webhooks to private, loopback and link-local addresses. Off by default;
# enable only when receivers live on the internal network.
# DOREG_WEBHOOK_ALLOW_PRIVATE=true

# --- Public browsing -----------------------------------------------------------
# Visitors without a session see public repositories in the web UI.
# DOREG_PUBLIC_BROWSE=true

# --- Production notes -----------------------------------------------------------
# Keycloak: OIDC_ISSUER=https://id.example.com/realms/<realm>
# AWS S3: S3_ENDPOINT=https://s3.<region>.amazonaws.com, S3_FORCE_PATH_STYLE=false
# See deploy/ for a deployment behind a TLS proxy.
